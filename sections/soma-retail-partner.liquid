{%- comment -%}
  SOMA Retail Partner Section with Full Custom Styles & Form Popup
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-title-color: {{ section.settings.text_title_color }};
    --text-desc-color: {{ section.settings.text_desc_color }};
    --accent-gold: {{ section.settings.accent_color }};
    
    --btn-bg: {{ section.settings.btn_bg_color }};
    --btn-text: {{ section.settings.btn_text_color }};
    --btn-hover: {{ section.settings.btn_hover_color }};

    /* Spacing Settings */
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  .soma-retail-section {
    background-color: var(--bg-color);
    text-align: center;
    font-family: 'Inter', sans-serif;
    padding-left: 24px;
    padding-right: 24px;
    width: 100%;
    box-sizing: border-box;
  }
  .soma-retail-subtitle {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 16px;
    display: block;
  }
  .soma-retail-title {
    font-family: 'Mattone', sans-serif;
    font-size: 42px;
    color: var(--text-title-color);
    max-width: 800px;
    margin: 0 auto 20px auto;
    line-height: 1.2;
  }
  .soma-retail-desc {
    font-size: 15px;
    color: var(--text-desc-color);
    max-width: 600px;
    margin: 0 auto 32px auto;
    line-height: 1.6;
  }
  .soma-retail-btn {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: none;
    padding: 14px 36px;
    font-size: 12px;
    letter-spacing: 0.2em;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .soma-retail-btn:hover {
    background-color: var(--btn-hover);
  }

  /* POPUP MODAL STYLES */
  .soma-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(55, 11, 17, 0.6);
    backdrop-filter: blur(4px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .soma-popup-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }
  .soma-popup-box {
    background: var(--bg-color);
    width: 100%;
    max-width: 500px;
    padding: 40px;
    position: relative;
    box-sizing: border-box;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }
  .soma-popup-overlay.is-open .soma-popup-box {
    transform: translateY(0);
  }
  .soma-popup-close {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 24px;
    background: none;
    border: none;
    color: var(--text-title-color);
    cursor: pointer;
  }
  
  .soma-popup-box h3 {
    font-family: 'Mattone', sans-serif;
    font-size: 24px;
    color: var(--text-title-color);
    margin-bottom: 8px;
    margin-top: 0;
  }
  .soma-popup-box p {
    font-size: 14px;
    color: var(--text-desc-color);
    margin-bottom: 24px;
  }
  .soma-form-group {
    margin-bottom: 16px;
    text-align: left;
  }
  .soma-form-group label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-title-color);
    margin-bottom: 6px;
  }
  .soma-form-group input, 
  .soma-form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid rgba(55, 11, 17, 0.15);
    background: #fff;
    font-family: inherit;
    font-size: 14px;
    color: var(--text-title-color);
    box-sizing: border-box;
  }
  .soma-form-group input:focus, 
  .soma-form-group textarea:focus {
    outline: 1px solid var(--accent-gold);
  }
  .soma-form-submit {
    width: 100%;
    margin-top: 10px;
  }

  /* Mobile Responsive Spacing */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .soma-retail-title { font-size: 28px; }
    .soma-popup-box { padding: 30px 20px; width: 90%; }
  }
</style>

<section class="soma-retail-section">
  <span class="soma-retail-subtitle">{{ section.settings.subtitle }}</span>
  {%- if section.settings.use_h1 -%}
    <h1 class="soma-retail-title">{{ section.settings.title }}</h1>
  {%- else -%}
    <h2 class="soma-retail-title">{{ section.settings.title }}</h2>
  {%- endif -%}
  <p class="soma-retail-desc">{{ section.settings.description }}</p>
  <button class="soma-retail-btn" id="openRetailPopup">{{ section.settings.btn_text }}</button>
</section>

<!-- POPUP MODAL -->
<div class="soma-popup-overlay" id="retailPopupOverlay">
  <div class="soma-popup-box">
    <button class="soma-popup-close" id="closeRetailPopup">&times;</button>
    
    <h3>{{ section.settings.popup_title }}</h3>
    <p>{{ section.settings.popup_desc }}</p>

    {%- form 'contact', id: 'RetailPartnerForm' -%}
      {%- if form.posted_successfully? -%}
        <p style="color: green; font-weight: 600;">Thank you! We will get back to you soon.</p>
        <script>
          document.addEventListener("DOMContentLoaded", function() {
            document.getElementById('retailPopupOverlay').classList.add('is-open');
          });
        </script>
      {%- elsif form.errors -%}
        <p style="color: red;">Please check the errors below.</p>
      {%- endif -%}

      <div class="soma-form-group">
        <label for="Form-Name">Full Name</label>
        <input type="text" id="Form-Name" name="contact[Name]" placeholder="Your name" required>
      </div>

      <div class="soma-form-group">
        <label for="Form-Email">Email Address</label>
        <input type="email" id="Form-Email" name="contact[email]" placeholder="name@example.com" required>
      </div>

      <div class="soma-form-group">
        <label for="Form-Phone">Business Phone</label>
        <input type="tel" id="Form-Phone" name="contact[Phone]" placeholder="+91 XXXXX XXXXX">
      </div>

      <div class="soma-form-group">
        <label for="Form-Message">Business Details / Message</label>
        <textarea id="Form-Message" name="contact[body]" rows="4" placeholder="Tell us about your salon, spa or retail store..." required></textarea>
      </div>

      <button type="submit" class="soma-retail-btn soma-form-submit">Submit Application</button>
    {%- endform -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const openBtn = document.getElementById('openRetailPopup');
    const closeBtn = document.getElementById('closeRetailPopup');
    const overlay = document.getElementById('retailPopupOverlay');

    if(openBtn && overlay) {
      openBtn.addEventListener('click', () => overlay.classList.add('is-open'));
    }
    if(closeBtn && overlay) {
      closeBtn.addEventListener('click', () => overlay.classList.remove('is-open'));
    }
    if(overlay) {
      overlay.addEventListener('click', (e) => {
        if(e.target === overlay) overlay.classList.remove('is-open');
      });
    }
  });
</script>

{% schema %}
{
  "name": "SOMA Retail Partner",
  "settings": [
    { "type": "header", "content": "Content Settings" },
    { "type": "text", "id": "subtitle", "label": "Top Subtitle", "default": "RETAIL PARTNER" },
    { "type": "text", "id": "title", "label": "Main Title", "default": "Give Clients More to Return To" },
    { "type": "checkbox", "id": "use_h1", "label": "Render title as H1", "info": "Enable when this is the page hero. Only one H1 per page.", "default": false },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Introduce a skincare ritual that elevates your service, supports client loyalty, and gives every visit a thoughtful retail extension." },
    { "type": "text", "id": "btn_text", "label": "Button Label", "default": "BECOME A RETAIL PARTNER" },
    
    { "type": "header", "content": "Popup Form Settings" },
    { "type": "text", "id": "popup_title", "label": "Popup Heading", "default": "Partner With SOMA" },
    { "type": "textarea", "id": "popup_desc", "label": "Popup Subtext", "default": "Please fill out this form and our partnership team will reach out within 24-48 hours." },

    { "type": "header", "content": "Color Customize Options" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#fcf9f8" },
    { "type": "color", "id": "text_title_color", "label": "Heading Text Color", "default": "#370b11" },
    { "type": "color", "id": "text_desc_color", "label": "Description Text Color", "default": "#555555" },
    { "type": "color", "id": "accent_color", "label": "Gold Accent Tag", "default": "#9a7e3d" },
    { "type": "color", "id": "btn_bg_color", "label": "Button Background", "default": "#370b11" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text", "default": "#fcf9f8" },
    { "type": "color", "id": "btn_hover_color", "label": "Button Hover Background", "default": "#9a7e3d" },

    { "type": "header", "content": "Desktop Spacing Control" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "margin_top_desktop", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Margin Top", "default": 0 },
    { "type": "range", "id": "margin_bottom_desktop", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Margin Bottom", "default": 0 },

    { "type": "header", "content": "Mobile Spacing Control" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Mobile Padding Top", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Mobile Padding Bottom", "default": 40 },
    { "type": "range", "id": "margin_top_mobile", "min": 0, "max": 50, "step": 5, "unit": "px", "label": "Mobile Margin Top", "default": 0 },
    { "type": "range", "id": "margin_bottom_mobile", "min": 0, "max": 50, "step": 5, "unit": "px", "label": "Mobile Margin Bottom", "default": 0 }
  ],
  "presets": [
    { "name": "SOMA Retail Partner" }
  ]
}
{% endschema %}