<section class="clinical-results-section section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="clinical-results__header">
        <h2 class="section-title italic-serif text-primary mb-large clinical-results__title ">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="clinical-results__grid">
      {%- for block in section.blocks -%}
        {%- assign metaobject_list = product.metafields.custom[block.settings.metafield_key].value -%}
        
        {%- if metaobject_list != blank -%}
          {%- for entry in metaobject_list -%}
            <div class="clinical-results__item" {{ block.shopify_attributes }}>
              {%- assign perc_field = block.settings.metafield_percentage | default: 'percentage' -%}
              {%- assign text_field = block.settings.metafield_text | default: 'text' -%}
              
              {%- if entry[perc_field] != blank -%}
                <div class="clinical-results__percentage">{{ entry[perc_field] }}</div>
              {%- endif -%}
              
              {%- if entry[text_field] != blank -%}
                <div class="clinical-results__desc">{{ entry[text_field] }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="clinical-results__item" {{ block.shopify_attributes }}>
            {%- if block.settings.percentage != blank -%}
              <div class="clinical-results__percentage">{{ block.settings.percentage | escape }}</div>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <div class="clinical-results__desc">{{ block.settings.description | escape }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .clinical-results-section {
    width: 100%;
    box-sizing: border-box;
  }

  .clinical-results-section .page-width {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .clinical-results__header {
    text-align: center;
    margin-bottom: 50px;
  }

  {% comment %} .clinical-results__title {
    font-size: 3rem;
    font-weight: 600;
    font-style: italic; 
    color: #420007; 
    margin: 0;
  } {% endcomment %}

  .clinical-results__grid {
    display: flex;
    justify-content: center;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 40px;
    position: relative;
  }

  .clinical-results__item {
    flex: 1;
    min-width: 280px;
    max-width: 480px;
    padding: 0 30px;
    position: relative;
    box-sizing: border-box;
  }

  .clinical-results__item:not(:last-child):after {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 10px;
    right: 0;
    width: 1px;
    background-color: #d8d8d8;
  }

  .clinical-results__percentage {
    font-size: 5rem;
    font-weight: 500;
    color: #420007;
    line-height: 1.1;
    margin-bottom: 15px;
  }

  {% comment %} .clinical-results__desc {
    font-size: 1.1rem;
    line-height: 1.5;
    color: #111111;
    margin: 0;
  } {% endcomment %}

  @media screen and (max-width: 768px) {
    .clinical-results__title {
      font-size: 2.2rem;
    }
    .clinical-results__percentage {
      font-size: 4rem;
    }
    .clinical-results__grid {
      gap: 30px;
    }
    .clinical-results__item:not(:last-child):after {
      display: none;
    }
    .clinical-results__item {
      padding: 0;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Product Clinical Stats",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Clinical results"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "result_item",
      "name": "Result Column",
      "settings": [
        {
          "type": "header",
          "content": "Dynamic data (metaobjects)"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Product metafield key (custom.___)",
          "default": "consumer_perception_results",
          "info": "e.g. consumer_perception_results"
        },
        {
          "type": "text",
          "id": "metafield_percentage",
          "label": "Metaobject field: percentage",
          "default": "percentage"
        },
        {
          "type": "text",
          "id": "metafield_text",
          "label": "Metaobject field: statement",
          "default": "text"
        },
        {
          "type": "header",
          "content": "Fallback Manual Data"
        },
        {
          "type": "text",
          "id": "percentage",
          "label": "Percentage / Stat (Fallback)",
          "default": "99%"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text (Fallback)",
          "default": "demonstrated a clinically proven improvement in lip barrier defense in severe wind and cold weather"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Clinical Stats",
      "blocks": [
        {
          "type": "result_item",
          "settings": {
            "percentage": "99%",
            "description": "demonstrated a clinically proven improvement in lip barrier defense in severe wind and cold weather"
          }
        },
        {
          "type": "result_item",
          "settings": {
            "percentage": "96%",
            "description": "showed an immediate and measurable increase in deep layer hydration"
          }
        }
      ]
    }
  ]
}
{% endschema %}