<section class="section" id="slider-{{ section.id }}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="container text-{{ section.settings.header_align }} mb-large">
      {%- if section.settings.eyebrow != blank -%}<h6 class="eyebrow text-muted">{{ section.settings.eyebrow | escape }}</h6>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-title italic-serif text-primary">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="section-subtitle">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="container slider-wrap">
    <button type="button" class="slider-nav slider-prev" aria-label="Previous"><span class="material-symbols-outlined">chevron_left</span></button>
    <div class="slider-track drag-scroll" data-slider-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }} {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} class="slide-card" {{ block.shopify_attributes }}>
          <div class="slide-card__media">
            {%- if img != blank -%}
              <img src="{{ img | image_url: width: 700 }}" width="{{ img.width }}" height="{{ img.height }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- else -%}
              <img src="{{ 'dusky-edit.jpg' | asset_url }}" width="1080" height="1350" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank or block.settings.caption != blank -%}
            <div class="slide-card__body">
              {%- if block.settings.title != blank -%}<h3 class="slide-card__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
              {%- if block.settings.caption != blank -%}<p class="slide-card__caption">{{ block.settings.caption | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
    <button type="button" class="slider-nav slider-next" aria-label="Next"><span class="material-symbols-outlined">chevron_right</span></button>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('slider-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-slider-track]');
    var step = function () { return Math.max(280, track.clientWidth * 0.8); };
    root.querySelector('.slider-prev').addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    root.querySelector('.slider-next').addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
  })();
</script>

{% schema %}
{
  "name": "Generic - Slider",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "header_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }
    ], "default": "center" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Slide title" },
        { "type": "textarea", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Generic - Slider",
      "blocks": [
        { "type": "slide", "settings": { "title": "Slide one" } },
        { "type": "slide", "settings": { "title": "Slide two" } },
        { "type": "slide", "settings": { "title": "Slide three" } },
        { "type": "slide", "settings": { "title": "Slide four" } }
      ]
    }
  ]
}
{% endschema %}
