<section class="section {{ section.settings.bg }}">
  <div class="container text-{{ section.settings.header_align }} max-w-4xl mx-auto">
    {%- if section.settings.eyebrow != blank -%}<h6 class="eyebrow text-muted">{{ section.settings.eyebrow | escape }}</h6>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section-title italic-serif text-primary mb-medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="generic-faq">
      {%- for block in section.blocks -%}
        <details class="group extracted-style-226" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="extracted-style-227">
            {{ block.settings.question | escape }}
            <span class="material-symbols-outlined">{% if forloop.first and section.settings.open_first %}expand_less{% else %}add{% endif %}</span>
          </summary>
          <div class="extracted-style-228">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Generic - FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "select", "id": "header_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }
    ], "default": "center" },
    { "type": "checkbox", "id": "open_first", "label": "Open first item by default", "default": false },
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "bg-surface", "label": "Surface" }, { "value": "bg-surface-alt", "label": "Surface alt" }, { "value": "", "label": "None" }
    ], "default": "bg-surface" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Generic - FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What makes Tulia different?", "answer": "<p>Formulations calibrated for Indian skin — our humidity, UV index and melanin-rich tones.</p>" } },
        { "type": "qa", "settings": { "question": "Are the products suitable for sensitive skin?", "answer": "<p>Yes — patch-tested and balanced with soothing botanicals.</p>" } },
        { "type": "qa", "settings": { "question": "Where are the products made?", "answer": "<p>Proudly made in India.</p>" } }
      ]
    }
  ]
}
{% endschema %}
