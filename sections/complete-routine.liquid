{%- liquid
  assign pmf = product.metafields.custom[section.settings.products_metafield_key]
  assign linked_products = pmf.value

  assign coming_soon_input = section.settings.coming_soon_products | newline_to_br | strip_newlines | split: '<br />'
-%}
<section id="complete-care-section" class="section bg-surface extracted-style-223">
  <div class="container text-center">
    <h2 class="section-title italic-serif text-primary mb-large">{{ section.settings.title | escape }}</h2>
    <div class="grid grid-3 gap-large">
      {%- if section.settings.products_metafield_key != blank and linked_products != blank and linked_products.size > 0 -%}
        {%- for entry in linked_products -%}
          {%- liquid
            assign linked = entry[section.settings.field_product].value
            assign badge = entry.title.value | split: '/' | first | strip
            assign display_title = linked.title | default: entry.title.value | strip | downcase
            assign is_coming_soon = false
            for cs_item in coming_soon_input
              assign cs_clean = cs_item | strip | downcase
              if cs_clean != blank
                if display_title == cs_clean
                  assign is_coming_soon = true
                else
                  assign cs_words = cs_clean | split: ' '
                  assign sig_count = 0
                  assign match_count = 0
                  for w in cs_words
                    if w.size > 2 and w != 'the' and w != 'and' and w != 'for'
                      assign sig_count = sig_count | plus: 1
                      if display_title contains w
                        assign match_count = match_count | plus: 1
                      endif
                    endif
                  endfor
                  if sig_count >= 2 and match_count == sig_count
                    assign is_coming_soon = true
                  endif
                endif
              endif
            endfor
          -%}
          <div class="complete-care-card group{% if is_coming_soon %} is-coming-soon-product{% endif %}"{% if is_coming_soon %} aria-disabled="true"{% endif %}>
            <div class="cc-img-wrapper">
              {%- if badge != blank -%}<span class="cc-badge">{{ badge | escape }}</span>{%- endif -%}
              {%- if linked != blank and linked.featured_image -%}
                {%- if is_coming_soon -%}
                  <img src="{{ linked.featured_image | image_url: width: 600 }}" width="600" height="600" alt="{{ linked.title | escape }}" class="extracted-style-64" loading="lazy">
                {%- else -%}
                  <a href="{{ linked.url }}"><img src="{{ linked.featured_image | image_url: width: 600 }}" width="600" height="600" alt="{{ linked.title | escape }}" class="extracted-style-64" loading="lazy"></a>
                {%- endif -%}
              {%- endif -%}
              {%- unless is_coming_soon -%}
                {%- if linked != blank and linked.available -%}
                  <form method="post" action="{{ routes.cart_add_url }}" data-ajax-cart style="margin:0;">
                    <input type="hidden" name="id" value="{{ linked.selected_or_first_available_variant.id }}">
                    <button type="submit" class="btn-quick-add extracted-style-224">Quick Add</button>
                  </form>
                {%- elsif linked != blank -%}
                  <a href="{{ linked.url }}" class="btn-quick-add extracted-style-224">Quick Add</a>
                {%- endif -%}
              {%- endunless -%}
            </div>
            <h3 class="cc-title">{{ linked.title | default: entry.title.value | escape }}</h3>
            {%- unless is_coming_soon -%}
              <div class="cc-meta"><span>{%- if linked -%}{{ linked.price | money }}{%- endif -%}</span></div>
            {%- endunless -%}
            <div class="cc-line"></div>
            <div class="cc-desc">{% render 'mo-text', field: entry[section.settings.field_description], allow_newline: true %}</div>
          </div>
        {%- endfor -%}
      {%- else -%}
      {%- for block in section.blocks -%}
        {%- assign linked = block.settings.product -%}
        {%- liquid
          assign display_title = linked.title | default: block.settings.title | strip | downcase
          assign is_coming_soon = block.settings.coming_soon
          unless is_coming_soon
            for cs_item in coming_soon_input
              assign cs_clean = cs_item | strip | downcase
              if cs_clean != blank
                if display_title == cs_clean
                  assign is_coming_soon = true
                else
                  assign cs_words = cs_clean | split: ' '
                  assign sig_count = 0
                  assign match_count = 0
                  for w in cs_words
                    if w.size > 2 and w != 'the' and w != 'and' and w != 'for'
                      assign sig_count = sig_count | plus: 1
                      if display_title contains w
                        assign match_count = match_count | plus: 1
                      endif
                    endif
                  endfor
                  if sig_count >= 2 and match_count == sig_count
                    assign is_coming_soon = true
                  endif
                endif
              endif
            endfor
          endunless
        -%}
        <div class="complete-care-card group{% if is_coming_soon %} is-coming-soon-product{% endif %}" {{ block.shopify_attributes }}{% if is_coming_soon %} aria-disabled="true"{% endif %}>
          <div class="cc-img-wrapper">
            {%- if block.settings.badge != blank -%}<span class="cc-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
            {%- if linked != blank and linked.featured_image -%}
              {%- if is_coming_soon -%}
                <img src="{{ linked.featured_image | image_url: width: 600 }}" width="600" height="600" alt="{{ linked.title | escape }}" class="extracted-style-64" loading="lazy">
              {%- else -%}
                <a href="{{ linked.url }}"><img src="{{ linked.featured_image | image_url: width: 600 }}" width="600" height="600" alt="{{ linked.title | escape }}" class="extracted-style-64" loading="lazy"></a>
              {%- endif -%}
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" width="600" height="600" alt="{{ block.settings.title | escape }}" class="extracted-style-64" loading="lazy">
            {%- else -%}
              <img src="{{ 'tulia_face_wash.png' | asset_url }}" width="1024" height="1024" alt="{{ block.settings.title | escape }}" class="extracted-style-64" loading="lazy">
            {%- endif -%}
            {%- unless is_coming_soon -%}
              {%- if linked != blank and linked.available -%}
                <form method="post" action="{{ routes.cart_add_url }}" data-ajax-cart style="margin:0;">
                  <input type="hidden" name="id" value="{{ linked.selected_or_first_available_variant.id }}">
                  <button type="submit" class="btn-quick-add extracted-style-224">Quick Add</button>
                </form>
              {%- else -%}
                <a href="{{ linked.url | default: '#' }}" class="btn-quick-add extracted-style-224">Quick Add</a>
              {%- endif -%}
            {%- endunless -%}
          </div>
          <h3 class="cc-title">{{ linked.title | default: block.settings.title | escape }}</h3>
          {%- unless is_coming_soon -%}
            <div class="cc-meta">
              {%- if block.settings.size != blank -%}<span>{{ block.settings.size | escape }}</span><span>—</span>{%- endif -%}
              <span>{%- if linked != blank -%}{{ linked.price | money }}{%- else -%}{{ block.settings.price | escape }}{%- endif -%}</span>
            </div>
          {%- endunless -%}
          <div class="cc-line"></div>
          <div class="cc-desc">{{ block.settings.description | escape | default: linked.description | strip_html | truncatewords: 40 }}</div>
        </div>
      {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<!-- Coming Soon: same pattern as collection page. Image markup untouched, clicks disabled via CSS, badge via JS -->
<style>
  #complete-care-section .complete-care-card.is-coming-soon-product a,
  #complete-care-section .complete-care-card.is-coming-soon-product button {
    pointer-events: none !important;
    cursor: not-allowed !important;
  }
  #complete-care-section .complete-care-card.is-coming-soon-product .cc-meta,
  #complete-care-section .complete-care-card.is-coming-soon-product .btn-quick-add {
    display: none !important;
  }
</style>

<script>
  (function() {
    function applyCompleteComingSoon() {
      const wrappers = document.querySelectorAll('#complete-care-section .complete-care-card.is-coming-soon-product');
      wrappers.forEach(wrapper => {
        if (wrapper.dataset.csDone === '1') return;
        wrapper.dataset.csDone = '1';
        const img = wrapper.querySelector('.cc-img-wrapper img');
        if (img) {
          img.style.filter = 'blur(4px)';
          let mediaContainer = img.parentElement;
          mediaContainer.style.position = 'relative';
          mediaContainer.style.overflow = 'hidden';
          const badgeOverlay = document.createElement('div');
          badgeOverlay.style.cssText = "position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.25); z-index: 2; pointer-events: none;";
          badgeOverlay.innerHTML = '<span style="background: #ffffff; color: #000000; padding: 8px 16px; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; border-radius: 4px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); white-space: nowrap;">Coming Soon</span>';
          mediaContainer.appendChild(badgeOverlay);
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyCompleteComingSoon);
    } else {
      applyCompleteComingSoon();
    }
  })();
</script>

{% schema %}
{
  "name": "Complete the routine",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Give your skin the complete care" },
    { "type": "header", "content": "Dynamic data (product references)" },
    { "type": "paragraph", "content": "When the product has this product-list metafield, those products are shown. Otherwise the manual blocks are used." },
    { "type": "text", "id": "products_metafield_key", "label": "Product metafield key (custom.___)", "default": "other_products" },
    { "type": "text", "id": "field_product", "label": "Metaobject field: linked product", "default": "image" },
    { "type": "text", "id": "field_description", "label": "Metaobject field: description", "default": "description" },
    { "type": "textarea", "id": "coming_soon_products", "label": "Coming Soon Products (Exact Names)", "info": "Ek line mein ek product ka exact naam likhein. Same list as collection page.", "default": "Hair Care Serum\nButterMax Cream\nThe Physical Sunscreen Gel\nDaily Care Shampoo" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Pulls live title, image, and price. Manual fields below are used as a fallback." },
        { "type": "checkbox", "id": "coming_soon", "label": "Coming Soon (non-clickable)", "default": false },
        { "type": "text", "id": "badge", "label": "Badge", "default": "PREP" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        { "type": "text", "id": "title", "label": "Fallback title", "default": "Tulia Skin Lightening & Brightening Facewash" },
        { "type": "text", "id": "size", "label": "Size", "default": "70gm" },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "₹850" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A rich, creamy exfoliating cleanser formulated with vitamin C and micro-globules to deeply wash away daily impurities while actively preparing your skin tone for target treatments" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Complete the routine",
      "blocks": [
        { "type": "product", "settings": { "badge": "PREP", "title": "Tulia Skin Lightening & Brightening Facewash", "size": "70gm", "price": "₹850", "description": "A rich, creamy exfoliating cleanser formulated with vitamin C and micro-globules to deeply wash away daily impurities while actively preparing your skin tone for target treatments" } },
        { "type": "product", "settings": { "badge": "HYDRATE", "title": "Tulia Lip Balm SPF 15", "size": "9gm", "price": "₹330", "description": "A daily pocket essential packed with kokum and shea butters to lock in long-lasting moisture and guard your lips against the elements all day long" } },
        { "type": "product", "settings": { "badge": "PROTECT", "title": "Tulia Physical Sunscreen Gel", "size": "50gm", "price": "₹1750", "description": "An ultra-transparent, non-comedogenic zinc oxide shield that leaves zero white patches while providing absolute broad-spectrum protection against UV damage" } }
      ]
    }
  ]
}
{% endschema %}
