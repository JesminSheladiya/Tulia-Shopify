<section class="tulia-contact-section">
  {% comment %} <div class="tulia-banner">
    <img 
      src="{{ section.settings.banner_image | image_url: width: 2400 }}" 
      alt="Contact Us"
      loading="lazy"
    >

    <div class="tulia-banner-overlay">
      <h1>Contact Us</h1>
    </div>
  </div> {% endcomment %}
  <div class="page-width container">

    <div class="tulia-contact-grid">

      <!-- Contact Information -->
      <div class="tulia-contact-info">

        <div class="tulia-card">
          <div class="tulia-icon">☎</div>
          <div>
            <h3>Support Phone</h3>
            <p>{{ section.settings.phone }}</p>
          </div>
        </div>


        <div class="tulia-card">
          <div class="tulia-icon">✉</div>
          <div>
            <h3>Email Address</h3>
            <p>{{ section.settings.email }}</p>
          </div>
        </div>


        <div class="tulia-card">
          <div class="tulia-icon">◷</div>
          <div>
            <h3>Business Hours</h3>
            <p>{{ section.settings.hours }}</p>
            <small>GST: {{ section.settings.gst }}</small>
          </div>
        </div>


        <div class="tulia-card">
          <div class="tulia-icon">⌖</div>
          <div>
            <h3>Headquarters</h3>
            <p>{{ section.settings.address }}</p>
          </div>
        </div>


      </div>


      <!-- Contact Form -->
      <div class="tulia-form">

        <h2>
          Have a Question?<br>
          Send Us a Message
        </h2>


        {% form 'contact' %}

        {% if form.posted_successfully? %}
          <p class="success">
            Thank you for contacting us. We will get back to you soon.
          </p>
        {% endif %}


        <div class="form-row">

          <input 
          type="text"
          name="contact[name]"
          placeholder="Full Name"
          aria-label="Full Name"
          required>


          <input 
          type="tel"
          name="contact[phone]"
          placeholder="Phone Number"
          aria-label="Phone Number">

        </div>


        <input 
        type="email"
        name="contact[email]"
        placeholder="Email Address"
        aria-label="Email Address"
        required>


        <textarea
        name="contact[body]"
        placeholder="Message"
        aria-label="Message"
        required></textarea>


        <button type="submit">
          Submit Message
        </button>


        {% endform %}

      </div>

    </div>

  </div>

  {% if section.settings.map != blank %}
<div class="page-width container">
  <div class="tulia-map">
    {{ section.settings.map }}
  </div>
</div>
  {% endif %}
</section>

<style>
textarea::placeholder, input::placeholder{
    font-family: var(--font-sans) !important;
}
.tulia-contact-section{
background:#fcf9f8;
}


.tulia-banner{
position:relative;
height:420px;
overflow:hidden;
}


.tulia-banner img{
width:100%;
height:100%;
object-fit:cover;
}


.tulia-banner-overlay{
position:absolute;
inset:0;
display:flex;
align-items:center;
justify-content:center;
background:rgba(0,0,0,.25);
}


.tulia-banner h1{
color:#fff;
font-size:clamp(2rem,5vw,4rem);
}


.tulia-contact-grid{
display:grid;
grid-template-columns:1fr 1.2fr;
gap:50px;
padding:70px 0;
}


.tulia-card{
display:flex;
gap:20px;
padding:25px;
border:1px solid #420007;
background:#fff;
margin-bottom:20px;
border-radius:10px;
}


.tulia-icon{
font-size:28px;
color:#420007;
}
.tulia-contact-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.container > div > div.tulia-contact-info > div:nth-child(4){
    margin-bottom: 0
}

.tulia-card h3{
font-size:14px;
text-transform:uppercase;
}


.tulia-card p{
color:#420007;
}


.tulia-form{
background:#fff;
padding:40px;
border:1px solid #420007;
border-radius:10px;
}


.tulia-form h2{
font-size:32px;
color:#420007;
margin-bottom:30px;
}


.tulia-form input,
.tulia-form textarea{

width:100%;
padding:15px;
margin-bottom:20px;
border:1px solid #420007;
font-size:16px;
}


.form-row{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}


.tulia-form textarea{
height:150px;
}


.tulia-form button{
width:100%;
padding:16px;
background:#420007;
color:white;
border:none;
cursor:pointer;

}


.tulia-map iframe{
width:100%;
height:450px;
border:0;

}

.tulia-map {
  padding: 0px 0 70px;
}


@media(max-width:768px){
  .tulia-map {
    padding: 0px 0 40px;
}
.tulia-banner{
height:280px;
}


.tulia-contact-grid{
grid-template-columns:1fr;
padding:40px 0;
gap:30px;
}


.tulia-form{
padding:25px;
}


.form-row{
grid-template-columns:1fr;
}


.tulia-form h2{
font-size:24px;
}


.tulia-card{
padding:18px;
}

}

</style>



{% schema %}
{
"name":"Tulia Contact Page",
"settings":[

{
"type":"image_picker",
"id":"banner_image",
"label":"Banner Image"
},

{
"type":"text",
"id":"phone",
"label":"Support Phone",
"default":"+91 8148148487"
},

{
"type":"text",
"id":"email",
"label":"Email",
"default":"tulia@baptisthealthcare.in"
},

{
"type":"text",
"id":"hours",
"label":"Business Hours",
"default":"10:00 AM to 06:30 PM"
},

{
"type":"text",
"id":"gst",
"label":"GST Number",
"default":"33AAKCB3314M1ZQ"
},

{
"type":"textarea",
"id":"address",
"label":"Address",
"default":"Plot No: 2, Tiruneermalai Main Rd, Subbaraya Nagar, Chromepet, Chennai, Tamil Nadu 600044"
},

{
"type":"textarea",
"id":"map",
"label":"Google Map Embed Code"
}

],
"presets":[
{
"name":"Tulia Contact Page"
}
]
}
{% endschema %}

