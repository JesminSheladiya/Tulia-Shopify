<section id="heritage" class="extracted-style-18">
  <div class="container grid {% if section.settings.hide_image %}grid-2{% else %}grid-3{% endif %} gap-large extracted-style-19">
    <div class="col-1 reveal-pan-left heritage-col-1 extracted-style-20">
      {%- if section.settings.eyebrow != blank -%}<h6 class="eyebrow text-muted">{{ section.settings.eyebrow | escape }}</h6>{%- endif -%}
      <h2 class="section-title mb-medium text-primary">{{ section.settings.title | escape | newline_to_br }}</h2>
    </div>

    {%- unless section.settings.hide_image -%}
    <div class="col-1 text-center heritage-col-2 heritage-mobile-bottom extracted-style-21">
      <div class="heritage-image-wrapper extracted-style-22">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" width="900" height="1125" alt="{{ section.settings.title | escape }}" class="extracted-style-23">
        {%- else -%}
          <img src="{{ 'angelin-2.png' | asset_url }}" width="1080" height="1350" alt="{{ section.settings.title | escape }}" class="extracted-style-23">
        {%- endif -%}
      </div>
    </div>
    {%- endunless -%}

    <div class="col-1 reveal-pan-right heritage-col-3 extracted-style-20">
      {%- if section.settings.paragraph_1 != blank -%}<p class="text-content mb-medium text-on-surface">{{ section.settings.paragraph_1 | escape }}</p>{%- endif -%}
      {%- if section.settings.paragraph_2 != blank -%}<p class="text-content mb-large text-on-surface">{{ section.settings.paragraph_2 | escape }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: '#' }}" class="link-with-icon extracted-style-24">
          <span class="extracted-style-25">{{ section.settings.link_label | escape }}</span>
          <span class="material-symbols-outlined">arrow_right_alt</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  /* 2-col (no image) mode: 50-50 desktop, stacked centered on tablet/mobile.
     !important beats the theme's tablet 3-col force rule. */
  #heritage .container.grid-2 { grid-template-columns: repeat(2, 1fr) !important; align-items: center; }
  #heritage .container.grid-2 .heritage-col-1,
  #heritage .container.grid-2 .heritage-col-3 { padding-bottom: 2rem !important; }
  @media screen and (max-width: 1024px) {
    /* breathing space: section was sticking edge-to-edge with the banner */
    #heritage:has(.container.grid-2) { padding-top: 3.5rem !important; padding-bottom: 3.5rem !important; }
    #heritage .container.grid-2 { grid-template-columns: 1fr !important; text-align: center; row-gap: 0 !important; }
    #heritage .container.grid-2 .heritage-col-1 { padding-top: 0 !important; padding-bottom: 0 !important; margin-bottom: 0 !important; }
    #heritage .container.grid-2 .heritage-col-3 { padding-top: 1.25rem !important; padding-bottom: 0 !important; text-align: center !important; }
    #heritage .container.grid-2 .heritage-col-3 .link-with-icon { display: flex; justify-content: center; margin-top: 0.5rem; }
    #heritage .container.grid-2 .section-title { margin-bottom: 0 !important; }
  }
</style>

{% schema %}
{
  "name": "Heritage",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Heritage" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "For every bronze and honey, for\nevery wavy and straight" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "hide_image", "label": "Hide image (50-50 two column layout)", "default": false },
    { "type": "textarea", "id": "paragraph_1", "label": "Paragraph 1", "default": "Indian beauty has always been rich in nuance." },
    { "type": "textarea", "id": "paragraph_2", "label": "Paragraph 2", "default": "And Tulia is thoughtfully formulated around the realities of these nuances; our climate, our textures, our routines, and the features we've been far too long told to change. Tulia is made for every hue and texture." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore Our Science" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [{ "name": "Heritage" }]
}
{% endschema %}
