<section class="section container reveal" style="max-width:1000px;margin:0 auto;">
  <div class="text-center mb-large">
    <h1 class="section-title italic-serif text-primary">{{ 'cart.general.title' | t }}</h1>
    <div class="divider mx-auto"></div>
  </div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">
      <div class="cart-items">
        {%- for item in cart.items -%}
          <div class="cart-row" style="display:grid;grid-template-columns:100px 1fr auto;gap:1.25rem;align-items:center;padding:1.25rem 0;border-bottom:1px solid var(--outline-variant);">
            <a href="{{ item.url }}">
              <img src="{{ item.image | image_url: width: 180 }}" width="180" height="180" alt="{{ item.title | escape }}" style="border-radius:var(--radius-sm);">
            </a>
            <div>
              <a href="{{ item.url }}"><h3 class="ritual-name italic-serif" style="font-size:1.2rem;height:auto !important;">{{ item.product.title }}</h3></a>
              {%- unless item.variant.title contains 'Default' -%}<p class="text-muted">{{ item.variant.title }}</p>{%- endunless -%}
              <p class="ritual-price">{{ item.final_price | money }}</p>
              <div style="display:flex;align-items:center;gap:1rem;margin-top:.5rem;">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" style="width:64px;padding:.4rem;border:1px solid var(--outline);border-radius:var(--radius-sm);">
                <a href="{{ item.url_to_remove }}" class="text-muted" style="text-decoration:underline;">{{ 'cart.general.remove' | t }}</a>
              </div>
            </div>
            <div class="ritual-price">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:1rem;margin-top:2rem;">
        <div style="font-size:1.3rem;">
          {{ 'cart.general.subtotal' | t }}: <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="text-muted">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
        <p style="margin:0;">Shipping: <s style="opacity:.6;">₹90</s> <strong style="color:var(--primary);letter-spacing:.08em;">FREE</strong></p>
        <div style="display:flex;gap:1rem;">
          <button type="submit" name="update" class="btn btn-outline-light" style="border-color:var(--primary);color:var(--primary);">{{ 'cart.general.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn-primary">{{ 'cart.general.checkout' | t }}</button>
        </div>
        <div class="cart-additional-checkout" style="width:100%;">{{ content_for_additional_checkout_buttons }}</div>
      </div>
    </form>
  {%- else -%}
    <div class="text-center">
      <p class="section-subtitle mb-medium">{{ 'cart.general.empty' | t }}</p>
      <a href="/collections/all-products" class="btn btn-primary">{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
