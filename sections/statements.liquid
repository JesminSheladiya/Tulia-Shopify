<section class="section {{ section.settings.bg }} statements-section">
  <div class="container text-{{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<h6 class="eyebrow text-muted">{{ section.settings.eyebrow | escape }}</h6>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section-title text-primary mb-large">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="statements-list">
      {%- for block in section.blocks -%}
        {%- unless forloop.first -%}<div class="statements-divider"></div>{%- endunless -%}
        <p class="statement-line italic-serif" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Generic - Statements",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }
    ], "default": "center" },
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "bg-surface-alt", "label": "Surface alt" }, { "value": "", "label": "Surface" }, { "value": "bg-surface-low", "label": "Surface low" }
    ], "default": "bg-surface-alt" }
  ],
  "blocks": [
    {
      "type": "statement",
      "name": "Statement",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Statement", "default": "Skin should not adjust to skincare but skincare should understand skin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Generic - Statements",
      "blocks": [
        { "type": "statement", "settings": { "text": "Skin should not adjust to skincare but skincare should understand skin" } },
        { "type": "statement", "settings": { "text": "Skincare need not be a complicated set of steps" } },
        { "type": "statement", "settings": { "text": "Good skincare should make you feel at home in your skin" } }
      ]
    }
  ]
}
{% endschema %}
