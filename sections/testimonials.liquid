{%- assign has_product_testimonials = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.product == product.handle -%}
    {%- assign has_product_testimonials = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_product_testimonials -%}
<section class="bg-surface reveal extracted-style-67">
  <div class="container">
    <div class="extracted-style-68">
      <h2 class="section-title text-primary extracted-style-69">{{ section.settings.title | escape }}</h2>
    </div>
    <div class="testimonial-carousel" id="testimonial-carousel">
      <div class="carousel-track" id="testimonial-track">
        {%- for block in section.blocks -%}
          {%- if block.settings.product == product.handle -%}
          <div class="minimal-testimonial extracted-style-70" style="flex: 0 0 360px; scroll-snap-align: start; height: auto;" {{ block.shopify_attributes }}>
            <div>
              {%- assign star_mod = forloop.index | modulo: 3 -%}
              {%- if star_mod == 0 -%}
                <p class="extracted-style-71">★★★★☆</p>
              {%- else -%}
                <p class="extracted-style-71">★★★★★</p>
              {%- endif -%}
              <p class="extracted-style-72">{{ block.settings.quote | escape }}</p>
              {%- assign show_product_image = false -%}
              {%- if block.settings.product_image != blank -%}
                {%- assign show_product_image = true -%}
              {%- elsif block.settings.name == "Meera Joshi" and product.handle == "spf-15-lip-balm" -%}
                {%- assign show_product_image = true -%}
              {%- endif -%}
              {%- if show_product_image -%}
                <div class="testimonial-product-image-wrapper">
                  <button class="testimonial-image-btn" onclick="openTestimonialImageModal('{{ block.settings.product_image | default: 'lipbalm-spf15-reviews.jpeg' | asset_url | escape }}', '{{ block.settings.name | escape }}')">
                    {%- if block.settings.product_image != blank -%}
                      <img src="{{ block.settings.product_image | image_url: width: 200 }}" alt="{{ block.settings.name | escape }}" class="testimonial-product-image">
                    {%- else -%}
                      <img src="{{ 'lipbalm-spf15-reviews.jpeg' | asset_url }}" alt="{{ block.settings.name | escape }}" class="testimonial-product-image">
                    {%- endif -%}
                  </button>
                </div>
              {%- endif -%}
            </div>
            <div class="extracted-style-73">
              {%- if block.settings.customer_image != blank -%}
                <img src="{{ block.settings.customer_image }}" alt="{{ block.settings.name | escape }}" class="testimonial-customer-image">
              {%- else -%}
                {%- assign name_words = block.settings.name | split: ' ' -%}
                {%- assign initial1 = name_words[0] | slice: 0, 1 -%}
                {%- assign initial2 = '' -%}
                {%- if name_words[1] != blank -%}{%- assign initial2 = name_words[1] | slice: 0, 1 -%}{%- endif -%}
                {%- assign initials = initial1 | append: initial2 | upcase -%}
                <div class="extracted-style-74" style="display:flex; align-items:center; justify-content:center; background:var(--surface-alt); font-weight:600; color:var(--primary);">
                  {{ initials }}
                </div>
              {%- endif -%}
              <div class="extracted-style-75">
                <h4 class="extracted-style-76">{{ block.settings.name | escape }}</h4>
              </div>
            </div>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div style="display:flex; align-items:center; justify-content:center; gap:1rem; margin-top:1.5rem;">
      <button type="button" id="testi-prev" class="btn btn-primary-light" aria-label="Previous testimonial" style="font-size:1.5rem; line-height:1; padding:0.2rem 1rem;">‹</button>
      <span id="testi-counter" class="text-muted"></span>
      <button type="button" id="testi-next" class="btn btn-primary-light" aria-label="Next testimonial" style="font-size:1.5rem; line-height:1; padding:0.2rem 1rem;">›</button>
    </div>
  </div>
</section>

<style>
  .testimonial-customer-image {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(0,0,0,0.08);
    margin-bottom: 0.5rem;
  }
  .testimonial-product-image-wrapper {
    margin-top: 0.75rem;
    width: fit-content;
  }
  .testimonial-product-image {
    width: 100px;
    height: 100px;
    border-radius: 8px;
    object-fit: cover;
    display: block;
    cursor: pointer;
    border: 2px solid rgba(0,0,0,0.1);
  }
  .testimonial-image-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>

<!-- Testimonial Image Modal -->
<div id="testimonial-image-modal" class="testimonial-modal" style="display:none;">
  <div class="testimonial-modal-overlay" onclick="closeTestimonialImageModal()"></div>
  <div class="testimonial-modal-content" onclick="event.stopPropagation()">
    <button class="testimonial-modal-close" onclick="closeTestimonialImageModal()">&times;</button>
    <img id="testimonial-modal-image" src="" alt="" class="testimonial-modal-image">
    <p id="testimonial-modal-title" class="testimonial-modal-title"></p>
  </div>
</div>

<style>
  .testimonial-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: none;
  }
  .testimonial-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
  }
  .testimonial-modal-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 800px;
    max-height: 90vh;
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }
  .testimonial-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    color: #333;
    line-height: 1;
  }
  .testimonial-modal-image {
    max-width: 100%;
    max-height: 60vh;
    border-radius: 8px;
    object-fit: contain;
    margin-bottom: 1rem;
  }
  .testimonial-modal-title {
    margin: 0;
    font-size: 1rem;
    color: #333;
    text-align: center;
    font-weight: 600;
  }
</style>

<script>
  function openTestimonialImageModal(imageSrc, title) {
    var modal = document.getElementById('testimonial-image-modal');
    var modalImg = document.getElementById('testimonial-modal-image');
    var modalTitle = document.getElementById('testimonial-modal-title');
    modalImg.src = imageSrc;
    modalTitle.textContent = title;
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  }
  function closeTestimonialImageModal() {
    var modal = document.getElementById('testimonial-image-modal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeTestimonialImageModal();
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Unfiltered" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Awesome! The level of customer service is excellent every time. \"Perfect on the first try or quickly adjusted.\" I'm so happy 😊" },
        { "type": "image_picker", "id": "customer_image", "label": "Customer image" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "DIVYA MENON" },
        { "type": "text", "id": "product", "label": "Product name", "default": "Buttermax Intensive" },
        { "type": "image_picker", "id": "product_image", "label": "Product image", "info": "Optional product photo shown below the review (like Google reviews)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "DIVYA MENON", "product": "Buttermax Intensive", "quote": "Awesome! The level of customer service is excellent every time. \"Perfect on the first try or quickly adjusted.\" I'm so happy 😊" } },
        { "type": "testimonial", "settings": { "name": "PRIYA NATARAJAN", "product": "Skin Lightening Facewash", "quote": "The products have a story just like the designers. I love my Tulia Skin Lightening Facewash! It truly feels refreshing every morning." } },
        { "type": "testimonial", "settings": { "name": "AISHWARYA RAO", "product": "Physical Sunscreen Gel", "quote": "I've been looking for physical sunscreen that doesn't leave a white cast. Tulia's formula is absolutely perfect for my skin tone!" } }
      ]
    }
  ]
}
{% endschema %}
