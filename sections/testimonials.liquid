{%- assign has_product_testimonials = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.product == product.handle -%}
    {%- assign has_product_testimonials = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_product_testimonials -%}
<section class="bg-surface reveal extracted-style-67">
  <div class="container">
    <div class="extracted-style-68">
      <h2 class="section-title text-primary extracted-style-69">{{ section.settings.title | escape }}</h2>
    </div>
    <div class="testimonial-carousel" id="testimonial-carousel">
      <div class="carousel-track" id="testimonial-track">
        {%- for block in section.blocks -%}
          {%- if block.settings.product == product.handle -%}
          <div class="minimal-testimonial extracted-style-70" style="flex: 0 0 360px; scroll-snap-align: start; height: auto;" {{ block.shopify_attributes }}>
            <div>
              {%- assign star_mod = forloop.index | modulo: 3 -%}
              {%- if star_mod == 0 -%}
                <p class="extracted-style-71">★★★★☆</p>
              {%- else -%}
                <p class="extracted-style-71">★★★★★</p>
              {%- endif -%}
              <p class="extracted-style-72">{{ block.settings.quote | escape }}</p>
            </div>
            <div class="extracted-style-73">
              {%- assign name_words = block.settings.name | split: ' ' -%}
              {%- assign initial1 = name_words[0] | slice: 0, 1 -%}
              {%- assign initial2 = '' -%}
              {%- if name_words[1] != blank -%}{%- assign initial2 = name_words[1] | slice: 0, 1 -%}{%- endif -%}
              {%- assign initials = initial1 | append: initial2 | upcase -%}
              <div class="extracted-style-74" style="display:flex; align-items:center; justify-content:center; background:var(--surface-alt); font-weight:600; color:var(--primary);">
                {{ initials }}
              </div>
              <div class="extracted-style-75">
                <h4 class="extracted-style-76">{{ block.settings.name | escape }}</h4>
              </div>
            </div>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div style="display:flex; align-items:center; justify-content:center; gap:1rem; margin-top:1.5rem;">
      <button type="button" id="testi-prev" class="btn btn-primary-light" aria-label="Previous testimonial" style="font-size:1.5rem; line-height:1; padding:0.2rem 1rem;">‹</button>
      <span id="testi-counter" class="text-muted"></span>
      <button type="button" id="testi-next" class="btn btn-primary-light" aria-label="Next testimonial" style="font-size:1.5rem; line-height:1; padding:0.2rem 1rem;">›</button>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Unfiltered" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Awesome! The level of customer service is excellent every time. \"Perfect on the first try or quickly adjusted.\" I'm so happy 😊" },
        { "type": "image_picker", "id": "customer_image", "label": "Customer image" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "DIVYA MENON" },
        { "type": "text", "id": "product", "label": "Product name", "default": "Buttermax Intensive" },
        { "type": "image_picker", "id": "product_image", "label": "Product image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "DIVYA MENON", "product": "Buttermax Intensive", "quote": "Awesome! The level of customer service is excellent every time. \"Perfect on the first try or quickly adjusted.\" I'm so happy 😊" } },
        { "type": "testimonial", "settings": { "name": "PRIYA NATARAJAN", "product": "Skin Lightening Facewash", "quote": "The products have a story just like the designers. I love my Tulia Skin Lightening Facewash! It truly feels refreshing every morning." } },
        { "type": "testimonial", "settings": { "name": "AISHWARYA RAO", "product": "Physical Sunscreen Gel", "quote": "I've been looking for physical sunscreen that doesn't leave a white cast. Tulia's formula is absolutely perfect for my skin tone!" } }
      ]
    }
  ]
}
{% endschema %}
