[
  {
    "name": "theme_info",
    "theme_name": "Tulia",
    "theme_version": "1.0.0",
    "theme_author": "Tulia Cosmetics",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo_color",
        "label": "Logo (dark / on light backgrounds)",
        "info": "Defaults to the bundled Tulia logo if left empty."
      },
      {
        "type": "image_picker",
        "id": "logo_white",
        "label": "Logo (white / on dark backgrounds)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary",
        "default": "#420007"
      },
      {
        "type": "color",
        "id": "color_primary_container",
        "label": "Primary container",
        "default": "#630f17"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary",
        "default": "#735c00"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / background",
        "default": "#fcf9f8"
      },
      {
        "type": "color",
        "id": "color_on_surface",
        "label": "Text on surface",
        "default": "#1b1c1c"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL",
        "default": "https://www.instagram.com/tuliacosmetics"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Slide-out drawer" },
          { "value": "page", "label": "Cart page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_ajax",
        "label": "Add to cart without page reload",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping",
        "label": "Show free-shipping progress bar",
        "default": true
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free-shipping threshold (in store currency, e.g. 999)",
        "default": "999"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable cart note",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search",
        "label": "Enable predictive (live) search",
        "default": true
      }
    ]
  }
]
