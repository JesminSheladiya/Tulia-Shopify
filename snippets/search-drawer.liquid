{%- comment -%} Slide-down search drawer with predictive results (progressively enhanced). {%- endcomment -%}
<div id="search-drawer" class="search-drawer" data-search-drawer aria-hidden="true">
  <div class="search-drawer__overlay" data-search-close></div>
  <div class="search-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form" data-predictive-form>
      <span class="material-symbols-outlined">search</span>
      <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" autocorrect="off" spellcheck="false" data-predictive-input aria-label="{{ 'general.search.search' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="search-drawer__close" data-search-close aria-label="Close">&times;</button>
    </form>
    <div class="search-drawer__results" data-predictive-results aria-live="polite"></div>
  </div>
</div>
