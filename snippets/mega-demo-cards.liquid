{%- comment -%}
  Fallback demo cards for the mega-menu when no collection is connected yet.
  Accepts: mobile (boolean) to switch markup between desktop carousel and mobile list.
{%- endcomment -%}
{%- assign demo = 'gleam.jpg|gleam|Skin Lightening Facewash|pigmentation dullness oil|,supple.jpg|tint|Lip lightening Cream|pigmentation tint|new,sun-kissed.jpg|plump|Lip Balm SPF 15|dullness hydration|,sun-kissed.jpg|sun-kissed|Physical Sunscreen Gel SPF 50+|oil|new,supple.jpg|supple|Buttermax Intensive Cream|hydration|,gleam.jpg|waves|All in One Shampoo|hair|,supple.jpg|smooth|All in One Conditioner|hair|,sun-kissed.jpg|shine|Hair Care Serum|hair|' | split: ',' -%}
{%- for row in demo -%}
  {%- assign p = row | split: '|' -%}
  {%- if mobile -%}
    <a href="{{ routes.all_products_collection_url }}" class="mobile-mega-card" data-category="{{ p[3] }}">
      <img src="{{ p[0] | asset_url }}" width="1080" height="1350" alt="{{ p[1] }}">
      <div><h4>{{ p[1] }}</h4><p>{{ p[2] }}</p></div>
      {%- if p[4] == 'new' -%}<span class="mobile-mega-badge">new</span>{%- endif -%}
    </a>
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}" class="mega-card" data-category="{{ p[3] }}">
      {%- if p[4] == 'new' -%}<span class="mega-badge">NEW</span>{%- endif -%}
      <img src="{{ p[0] | asset_url }}" width="1080" height="1350" alt="{{ p[1] }}">
      <div><h4>{{ p[1] }}</h4><p>{{ p[2] }}</p></div>
    </a>
  {%- endif -%}
{%- endfor -%}
