<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" href="{{ 'fav-icon.png' | asset_url }}">
  {%- endif -%}
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&icon_names=add,apartment,arrow_left_alt,arrow_right_alt,arrow_upward,auto_awesome,autorenew,block,brightness_auto,brush,chat,check,check_circle,chevron_left,chevron_right,content_cut,credit_card,eco,equalizer,expand_more,fact_check,format_quote,healing,health_and_safety,light_mode,local_activity,local_hospital,local_mall,local_shipping,location_on,lock,menu,pets,play_circle,psychology,redeem,replay,routine,schedule,science,search,spa,storefront,today,touch_app,verified,verified_user,visibility,water_drop&display=swap" rel="stylesheet">

  <!-- Google Tag Manager (consent-gated): loads only after cookie consent -->
  <script>
    window.dataLayer = window.dataLayer || [];
    window.tuliaGTMLoaded = false;
    window.tuliaLoadGTM = function () {
      if (window.tuliaGTMLoaded) return;
      window.tuliaGTMLoaded = true;
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-W7766LPC');
    };
    (function () {
      var consent = null;
      try { consent = localStorage.getItem('tulia_cookie_consent'); } catch (e) {}
      if (consent === 'accepted') window.tuliaLoadGTM();
    })();
  </script>

  {{ content_for_header }}
  {{ 'style.css' | asset_url | stylesheet_tag }}
  <style>
    @font-face { font-family: 'Montserrat'; src: url('{{ "Montserrat-400.woff2" | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
    @font-face { font-family: 'Montserrat'; src: url('{{ "Montserrat-500.woff2" | asset_url }}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
    @font-face { font-family: 'Montserrat'; src: url('{{ "Montserrat-600.woff2" | asset_url }}') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }
    @font-face { font-family: 'Montserrat'; src: url('{{ "Montserrat-700.woff2" | asset_url }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
    @font-face { font-family: 'Mattone'; src: url('{{ "Mattone-Regular.otf" | asset_url }}') format('opentype'); font-weight: 400; font-style: normal; font-display: swap; }
    :root { --primary: {{ settings.color_primary | default: '#420007' }}; --surface: {{ settings.color_surface | default: '#fcf9f8' }}; --font-sans: 'Montserrat', sans-serif; --font-serif: 'Musky', 'Mattone', serif; }
  </style>
</head>
<body class="template-password">
    <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% render 'cookie-banner' %}
</body>
</html>
