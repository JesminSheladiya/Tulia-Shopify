<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">


  


<head>
  <!-- Google Tag Manager: loads ONLY after cookie consent (cookie-banner snippet calls tuliaLoadGTM on Accept) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    window.tuliaGTMLoaded = false;
    window.tuliaLoadGTM = function () {
      if (window.tuliaGTMLoaded) return;
      window.tuliaGTMLoaded = true;
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-W7766LPC');
    };
    (function () {
      var consent = null;
      try { consent = localStorage.getItem('tulia_cookie_consent'); } catch (e) {}
      var apiAllowed = false;
      try {
        if (window.Shopify && Shopify.customerPrivacy && typeof Shopify.customerPrivacy.marketingAllowed === 'function') {
          apiAllowed = Shopify.customerPrivacy.marketingAllowed() === true;
        }
      } catch (e) {}
      if (consent === 'accepted' || apiAllowed) window.tuliaLoadGTM();
    })();
  </script>
  <!-- End Google Tag Manager (consent-gated) -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" href="{{ 'fav-icon.png' | asset_url }}">
  {%- endif -%}

  {% comment %} Custom page titles per URL {% endcomment %}
  {%- liquid
    assign custom_page_title = blank
    if request.page_type == 'index'
      assign custom_page_title = 'Premium Skincare, Haircare & Lip Care | Tulia Cosmetics'
    elsif collection.handle == 'all-products'
      assign custom_page_title = 'Shop All Cosmetics, Skincare & Haircare | Tulia Cosmetics'
    elsif collection.handle == 'all'
      assign custom_page_title = 'Explore Our Full Range of Beauty Products | Tulia Cosmetics'
    elsif collection.handle == 'hair-scalp'
      assign custom_page_title = 'Nourishing Hair & Scalp Care Products | Tulia Cosmetics'
    elsif collection.handle == 'lipcare' or collection.handle == 'lip-care' or collection.handle == 'lip-care-collection'
      assign custom_page_title = 'Hydrating Lip Care & Lip Balm Products | Tulia Cosmetics'
    elsif collection.handle == 'skincare-with-products'
      assign custom_page_title = 'Natural Skincare Products & Facewashes | Tulia Cosmetics'
    elsif page.handle == 'about-us'
      assign custom_page_title = 'About Us | Pure, Safe & Effective Beauty | Tulia Cosmetics'
    elsif page.handle == 'contact'
      assign custom_page_title = 'Contact Us | Get in Touch with Tulia Cosmetics Support'
    elsif page.handle == 'become-our-partner' or page.handle == 'become-a-partner'
      assign custom_page_title = 'Become a Partner & Distributor | Tulia Cosmetics'
    elsif page.handle == 'our-story'
      assign custom_page_title = 'Our Story | The Passion Behind Tulia Cosmetics'
    elsif product.handle == 'lip-balm'
      assign custom_page_title = 'Nourishing Lip Balm for Dry Lips | Tulia Cosmetics'
    elsif product.handle == 'all-in-one-conditioner'
      assign custom_page_title = 'All-in-One Hair Conditioner for Smooth Hair | Tulia Cosmetics'
    elsif product.handle == 'skin-lightening-brightening-facewash'
      assign custom_page_title = 'Skin Lightening & Brightening Facewash | Tulia Cosmetics'
    elsif product.handle == 'lipz-lightening-cream'
      assign custom_page_title = 'Lipz Lip Lightening Cream for Dark Lips | Tulia Cosmetics'
    endif

    if custom_page_title == blank
      if request.path == '/pages/about-us'
        assign custom_page_title = 'About Us | Pure, Safe & Effective Beauty | Tulia Cosmetics'
      elsif request.path == '/pages/contact'
        assign custom_page_title = 'Contact Us | Get in Touch with Tulia Cosmetics Support'
      elsif request.path contains 'become'
        assign custom_page_title = 'Become a Partner & Distributor | Tulia Cosmetics'
      elsif request.path == '/pages/our-story'
        assign custom_page_title = 'Our Story | The Passion Behind Tulia Cosmetics'
      elsif request.path contains '/products/lip-balm'
        assign custom_page_title = 'Nourishing Lip Balm for Dry Lips | Tulia Cosmetics'
      elsif request.path contains '/products/all-in-one-conditioner'
        assign custom_page_title = 'All-in-One Hair Conditioner for Smooth Hair | Tulia Cosmetics'
      elsif request.path contains '/products/skin-lightening-brightening-facewash'
        assign custom_page_title = 'Skin Lightening & Brightening Facewash | Tulia Cosmetics'
      elsif request.path contains '/products/lipz-lightening-cream'
        assign custom_page_title = 'Lipz Lip Lightening Cream for Dark Lips | Tulia Cosmetics'
      endif
    endif
  -%}

  <title>
    {%- if custom_page_title != blank -%}
      {{ custom_page_title | escape }}
    {%- else -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- endif -%}
  </title>

  {% comment %} Custom meta descriptions per URL {% endcomment %}
  {%- liquid
    assign custom_meta_description = blank
    if request.page_type == 'index'
      assign custom_meta_description = 'Discover Tulia Cosmetics for clean, high-performance skincare, hair, and lip care essentials. Nourish your skin naturally with our premium beauty formulas.'
    elsif collection.handle == 'all-products'
      assign custom_meta_description = 'Explore our full range of clean skincare, hair care, and lip care products at Tulia Cosmetics. Shop natural formulas crafted for healthy, glowing skin.'
    elsif collection.handle == 'all'
      assign custom_meta_description = 'Browse the complete Tulia Cosmetics collection. Discover top-rated skincare essentials, nourishing hair formulas, and hydrating lip care products.'
    elsif collection.handle == 'hair-scalp'
      assign custom_meta_description = 'Revitalize your hair and scalp with Tulia Cosmetics. Shop nourishing hair care treatments formulated to promote healthy growth, strength, and shine.'
    elsif collection.handle == 'lipcare' or collection.handle == 'lip-care' or collection.handle == 'lip-care-collection'
      assign custom_meta_description = 'Treat your lips to deep hydration with Tulia Cosmetics lip care collection. Nourishing lip balms and treatments for soft, smooth, and healthy lips.'
    elsif collection.handle == 'skincare-with-products'
      assign custom_meta_description = 'Transform your skincare routine with Tulia Cosmetics. Explore our gentle, effective cleansers, serums, and moisturizers for radiant, healthy skin.'
    elsif page.handle == 'about-us'
      assign custom_meta_description = "Learn about Tulia Cosmetics' commitment to natural beauty, high-quality ingredients, and sustainable skincare solutions designed to empower your skin."
    elsif page.handle == 'contact'
      assign custom_meta_description = 'Have questions about our products or your order? Get in touch with the Tulia Cosmetics team. We are here to help you with all your skincare needs.'
    elsif page.handle == 'become-our-partner' or page.handle == 'become-a-partner'
      assign custom_meta_description = 'Partner with Tulia Cosmetics! Join our growing network of beauty stockists, distributors, and partners to share clean, premium skincare products worldwide.'
    elsif page.handle == 'our-story'
      assign custom_meta_description = 'Discover the story behind Tulia Cosmetics. Learn about our passion, mission, and dedication to creating effective, clean beauty routines for everyone.'
    elsif product.handle == 'lip-balm'
      assign custom_meta_description = 'A rich, potent lip balm by Tulia Cosmetics designed to deeply hydrate, heal, and protect your lips, keeping them soft and smooth all day long.'
    elsif product.handle == 'all-in-one-conditioner'
      assign custom_meta_description = 'An advanced all-in-one hair conditioner by Tulia Cosmetics that detangles, smooths, and deeply nourishes your hair for a healthy, radiant shine.'
    elsif product.handle == 'skin-lightening-brightening-facewash'
      assign custom_meta_description = 'An active-powered skin brightening facewash by Tulia Cosmetics that gently cleanses, removes impurities, and promotes an even, glowing complexion.'
    elsif product.handle == 'lipz-lightening-cream'
      assign custom_meta_description = "A restorative lip lightening cream by Tulia Cosmetics that helps reduce dark pigmentation and restores your lips' natural, healthy pink tone."
    endif

    if custom_meta_description == blank
      if request.path == '/pages/about-us'
        assign custom_meta_description = "Learn about Tulia Cosmetics' commitment to natural beauty, high-quality ingredients, and sustainable skincare solutions designed to empower your skin."
      elsif request.path == '/pages/contact'
        assign custom_meta_description = 'Have questions about our products or your order? Get in touch with the Tulia Cosmetics team. We are here to help you with all your skincare needs.'
      elsif request.path contains 'become'
        assign custom_meta_description = 'Partner with Tulia Cosmetics! Join our growing network of beauty stockists, distributors, and partners to share clean, premium skincare products worldwide.'
      elsif request.path == '/pages/our-story'
        assign custom_meta_description = 'Discover the story behind Tulia Cosmetics. Learn about our passion, mission, and dedication to creating effective, clean beauty routines for everyone.'
      elsif request.path contains '/products/lip-balm'
        assign custom_meta_description = 'A rich, potent lip balm by Tulia Cosmetics designed to deeply hydrate, heal, and protect your lips, keeping them soft and smooth all day long.'
      elsif request.path contains '/products/all-in-one-conditioner'
        assign custom_meta_description = 'An advanced all-in-one hair conditioner by Tulia Cosmetics that detangles, smooths, and deeply nourishes your hair for a healthy, radiant shine.'
      elsif request.path contains '/products/skin-lightening-brightening-facewash'
        assign custom_meta_description = 'An active-powered skin brightening facewash by Tulia Cosmetics that gently cleanses, removes impurities, and promotes an even, glowing complexion.'
      elsif request.path contains '/products/lipz-lightening-cream'
        assign custom_meta_description = "A restorative lip lightening cream by Tulia Cosmetics that helps reduce dark pigmentation and restores your lips' natural, healthy pink tone."
      endif
    endif
  -%}

  {% if custom_meta_description != blank %}
    <meta name="description" content="{{ custom_meta_description | escape }}">
  {% elsif page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% comment %} Open Graph + Twitter share tags {% endcomment %}
  {%- liquid
    assign og_title = custom_page_title
    if og_title == blank
      assign og_title = page_title
    endif
    assign og_description = custom_meta_description
    if og_description == blank
      assign og_description = page_description
    endif
    if og_description == blank
      assign og_description = shop.description
    endif
    assign og_type = 'website'
    if request.page_type == 'product'
      assign og_type = 'product'
    elsif request.page_type == 'article'
      assign og_type = 'article'
    endif
    assign og_image = blank
    if request.page_type == 'product' and product.featured_image
      assign og_image = product.featured_image | image_url: width: 1200
    elsif request.page_type == 'article' and article.image
      assign og_image = article.image | image_url: width: 1200
    elsif settings.logo_color != blank
      assign og_image = settings.logo_color | image_url: width: 1200
    endif
  -%}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ og_title | escape }}">
  <meta property="og:type" content="{{ og_type }}">
  {%- if og_description != blank -%}
    <meta property="og:description" content="{{ og_description | escape }}">
  {%- endif -%}
  {%- if og_image != blank -%}
    <meta property="og:image" content="https:{{ og_image }}">
    <meta property="og:image:width" content="1200">
  {%- endif -%}
  <meta name="twitter:card" content="{% if og_image != blank %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ og_title | escape }}">
  {%- if og_description != blank -%}
    <meta name="twitter:description" content="{{ og_description | escape }}">
  {%- endif -%}
  {%- if og_image != blank -%}
    <meta name="twitter:image" content="https:{{ og_image }}">
  {%- endif -%}

  {% comment %} Brand tokens: Musky (display) + Montserrat (body, locally hosted in assets). {% endcomment %}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'style.css' | asset_url | stylesheet_tag }}

  <style>
    @font-face {
      font-family: 'Montserrat';
      src: url('{{ "Montserrat-300.woff2" | asset_url }}') format('woff2');
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Montserrat';
      src: url('{{ "Montserrat-400.woff2" | asset_url }}') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Montserrat';
      src: url('{{ "Montserrat-500.woff2" | asset_url }}') format('woff2');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Montserrat';
      src: url('{{ "Montserrat-600.woff2" | asset_url }}') format('woff2');
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Montserrat';
      src: url('{{ "Montserrat-700.woff2" | asset_url }}') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Mattone';
      src: url('{{ "Mattone-Regular.otf" | asset_url }}') format('opentype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    /* TODO: upload Musky font files to assets then add @font-face for 'Musky' */

    :root {
      --primary: {{ settings.color_primary | default: '#420007' }};
      --primary-container: {{ settings.color_primary_container | default: '#630f17' }};
      --on-primary: #ffffff;
      --secondary: {{ settings.color_secondary | default: '#735c00' }};
      --secondary-fixed: #ffe088;
      --tertiary: #1b1c19;
      --on-tertiary: #ffffff;
      --surface: {{ settings.color_surface | default: '#fcf9f8' }};
      --surface-alt: #f0eded;
      --surface-low: #f6f3f2;
      --surface-variant: #e4e2e1;
      --on-surface: {{ settings.color_on_surface | default: '#1b1c1c' }};
      --on-surface-variant: #564241;
      --outline: #897171;
      --outline-variant: #dcc0bf;
      --font-sans: 'Montserrat', sans-serif;
      --font-serif: 'Musky', 'Mattone', serif;
    }

    body { background-color: {{ settings.color_surface | default: '#fcf9f8' }}; font-family: var(--font-sans); }
  </style>

</head>

<body class="template-{{ request.page_type | handle }}">
  {% comment %} GTM noscript removed: tracking (incl. noscript) loads only after cookie consent {% endcomment %}

  {% sections 'header-group' %}

  {%- liquid
    assign is_cs_product = false
    if request.page_type == 'product' and product != blank
      assign cs_p_down = product.title | strip | downcase
      assign cs_names = 'hair care serum,buttermax cream,the physical sunscreen gel,daily care shampoo,' | split: ','
      for cs_item in cs_names
        assign cs_clean = cs_item | strip
        if cs_clean != blank
          if cs_p_down == cs_clean
            assign is_cs_product = true
          else
            assign cs_words = cs_clean | split: ' '
            assign sig_count = 0
            assign match_count = 0
            for w in cs_words
              if w.size > 2 and w != 'the' and w != 'and' and w != 'for'
                assign sig_count = sig_count | plus: 1
                if cs_p_down contains w
                  assign match_count = match_count | plus: 1
                endif
              endif
            endfor
            if sig_count >= 2 and match_count == sig_count
              assign is_cs_product = true
            endif
          endif
        endif
      endfor
    endif
  -%}
  <main id="MainContent" role="main">
    {%- if is_cs_product -%}
      <section class="cs-splash">
        {%- if product.featured_image -%}
          <div class="cs-splash__bg"><img src="{{ product.featured_image | image_url: width: 1600 }}" width="1600" height="1000" alt="" loading="lazy"></div>
        {%- endif -%}
        <div class="cs-splash__content">
          <p class="cs-splash__eyebrow">Tulia Cosmetics</p>
          <h1 class="cs-splash__title">{{ product.title | escape }}</h1>
          <span class="cs-splash__pill">Coming Soon</span>
          <p class="cs-splash__text">This formulation is still in the lab. Explore the collection meanwhile.</p>
          <a href="{{ routes.collections_url }}/all-products" class="btn btn-primary">Explore the collection</a>
        </div>
      </section>
      <style>
        .cs-splash { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; text-align: center; min-height: 70vh; padding: 4rem 1.5rem; background: #fcf9f8; }
        .cs-splash__bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
        .cs-splash__bg img { width: 100%; height: 100%; object-fit: cover; filter: blur(12px); opacity: 0.35; }
        .cs-splash__content { position: relative; z-index: 1; max-width: 560px; }
        .cs-splash__eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--primary); font-weight: 600; margin-bottom: 1rem; }
        .cs-splash__title { font-size: 2.5rem; line-height: 1.1; color: var(--primary); margin-bottom: 1.25rem; }
        .cs-splash__pill { display: inline-block; background: #ffffff; color: #000000; padding: 8px 20px; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; border-radius: 4px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); margin-bottom: 1.25rem; }
        .cs-splash__text { color: var(--on-surface-variant); margin-bottom: 2rem; }
        @media screen and (max-width: 768px) { .cs-splash__title { font-size: 1.9rem; } }
      </style>
    {%- else -%}
      {{ content_for_layout }}
    {%- endif -%}
  </main>

  {% sections 'footer-group' %}

  <!-- Back to top -->
  <button id="back-to-top" aria-label="Back to top">
    <span class="material-symbols-outlined">arrow_upward</span>
  </button>

  {% render 'sticky-bottom-bar' %}
  {% render 'waitlist-modal' %}
  {% render 'cookie-banner' %}

  {%- if settings.cart_type == 'drawer' -%}
    {% section 'cart-drawer' %}
  {%- endif -%}

  {% render 'search-drawer' %}

  <script>
    window.tuliaCartAjax = {{ settings.cart_ajax | json }};
    window.tuliaCartType = {{ settings.cart_type | json }};
    window.tuliaPredictiveSearch = {{ settings.predictive_search | json }};
    window.tuliaRoutes = {
      cart_add: "{{ routes.cart_add_url }}",
      cart_change: "{{ routes.cart_change_url }}",
      cart_update: "{{ routes.cart_update_url }}",
      cart: "{{ routes.cart_url }}",
      predictive: "{{ routes.predictive_search_url }}"
    };
    window.tuliaMoneyFormat = {{ shop.money_format | json }};
  </script>
  <script src="{{ 'script.js' | asset_url }}" defer></script>
  <script src="{{ 'product_detail.js' | asset_url }}" defer></script>
  <script src="{{ 'tulia-cart.js' | asset_url }}" defer></script>
  <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>


  {% comment %} -------Custom Script For '&'------- {% endcomment %}
<script>
  function fixCartDrawerAmpersand() {
    const cartTitles = document.querySelectorAll('.cart-drawer__item-title, .ritual-name, .product-single__title, .product-title, h1, h2, h3');
    
    cartTitles.forEach(function(title) {
      if (title.querySelector('.fixed-amp')) return;
      if (title.innerHTML.includes('&amp;') || title.innerHTML.includes('&amp;amp;')) {
        title.innerHTML = title.innerHTML.replace(/&amp;/g, '<span class="fixed-amp" style="font-family: inherit !important; font-style: normal !important; display: inline-block !important;">&</span>');
      } else if (title.innerText.includes('&') || title.textContent.includes('&')) {
        title.innerHTML = title.innerHTML.replace(/&/g, '<span class="fixed-amp" style="font-family: inherit !important; font-style: normal !important; display: inline-block !important;">&</span>');
      }
    });
  }
  document.addEventListener("DOMContentLoaded", fixCartDrawerAmpersand);
  const cartObserver = new MutationObserver(function() {
    fixCartDrawerAmpersand();
  });

  cartObserver.observe(document.body, {
    childList: true,
    subtree: true
  });
</script>






</body>

</html>
