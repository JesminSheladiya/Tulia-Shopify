    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Is this body butter suitable for daily use?",
            "answer": "Yes. Our Body Butter Cream can be used daily as part of your regular body care routine to help keep your skin nourished and moisturised."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Can I use it on very dry skin?",
            "answer": "Yes. Enriched with Shea Butter, Cocoa Butter and nourishing oils, its rich formula helps condition dry skin and improve its softness."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "When is the best time to apply body butter?",
            "answer": "The ideal time is after a shower or bath, when your skin is slightly damp. This helps retain moisture and leaves your skin feeling soft and hydrated."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Will it leave my skin feeling greasy?",
            "answer": "Body butter has a richer texture than regular body lotions. Massage a suitable amount evenly into your skin and allow it to absorb before dressing."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Can I use it on my elbows, knees and heels?",
            "answer": "Absolutely. These areas are often prone to dryness. Apply a little extra product and massage gently for added nourishment."
          }
        }
      },
