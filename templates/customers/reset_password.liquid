<section class="section container reveal" style="max-width:480px;margin:0 auto;">
  <div class="text-center mb-large">
    <h1 class="section-title italic-serif text-primary">Reset password</h1>
    <div class="divider mx-auto"></div>
  </div>
  {%- assign field_css = 'width:100%;border:1px solid var(--outline);padding:.75rem;border-radius:var(--radius-sm);margin:.5rem 0 1rem;color:var(--on-surface);' -%}
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label for="ResetPassword">New password</label>
    <input type="password" name="customer[password]" id="ResetPassword" style="{{ field_css }}">
    <label for="ResetPasswordConfirm">Confirm password</label>
    <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" style="{{ field_css }}">
    <button type="submit" class="btn btn-primary">Reset password</button>
  {%- endform -%}
</section>
