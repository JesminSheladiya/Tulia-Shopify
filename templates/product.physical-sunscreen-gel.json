    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Does this sunscreen leave a white cast?",
            "answer": "Our Physical Sunscreen Gel is formulated with 25% Zinc Oxide and Index Match Technology to minimise visible white patches, offering a more seamless sunscreen application."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Is this sunscreen suitable for daily use?",
            "answer": "Yes. Its SPF 50+ PA+++ formulation provides broad-spectrum UVA and UVB protection, making it suitable for everyday sun protection."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "How often should I reapply it?",
            "answer": "For effective sun protection, reapply every two hours when outdoors. Reapply after swimming, sweating or towel drying."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Is it water resistant?",
            "answer": "Yes. The formula is designed to be very water resistant. However, reapplication is still necessary, especially after swimming or excessive sweating."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Can I apply makeup over this sunscreen?",
            "answer": "The formula is non-comedogenic, which means it is designed not to clog pores. If you have acne-prone or sensitive skin, check with your dermatologist to ensure it suits your individual skin needs."
          }
        }
      },
