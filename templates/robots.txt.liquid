{% comment %}
  robots.txt: Shopify defaults preserved. Shopify's default /sitemap.xml is
  auto-generated at the platform level and referenced via group.sitemap.
{% endcomment %}
{% for group in robots.default_groups %}
  {{- group.user_agent -}}
  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}
  {{- group.sitemap -}}
{% endfor %}
