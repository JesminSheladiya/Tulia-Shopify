{% comment %}
  Custom robots.txt: Shopify defaults preserved + custom sitemap reference.
  NOTE: Shopify's default /sitemap.xml cannot be overridden - it is
  auto-generated at the platform level. So the custom sitemap is served
  at /pages/custom-sitemap and referenced here. Submit it separately
  in Google Search Console.
{% endcomment %}
{% for group in robots.default_groups %}
  {{- group.user_agent -}}
  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}
  {{- group.sitemap -}}
{% endfor %}
Sitemap: {{ shop.url }}/pages/custom-sitemap
