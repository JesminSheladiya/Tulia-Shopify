    <!-- 10) Frequently Asked Questions -->
    <section id="faq" class="section container reveal">
        <div class="section-header text-center mb-large">
            <span class="eyebrow text-muted">FAQ</span>
            <h2 class="section-title text-primary">Frequently asked questions</h2>
