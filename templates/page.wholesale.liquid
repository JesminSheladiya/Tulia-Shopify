        <div class="faq-accordion max-w-4xl mx-auto">
            <!-- FAQ 1 -->
            <div class="faq-item active">
                <button class="faq-question" aria-expanded="true">
                    <span>Who can partner with Tulia?</span>
                    <span class="faq-toggle">×</span>
                </button>
                <div class="faq-answer">
                    <p>Salons, spas, skin and aesthetic clinics, freelance beauticians and makeup artists, retail stockists and pharmacies, hotels, corporate gifting buyers, and dealers and distributors. Select your business type on the form.</p>
                </div>
            </div>

            <!-- FAQ 2 -->
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false">
                    <span>What is the minimum order?</span>
                    <span class="faq-toggle">+</span>
                </button>
                <div class="faq-answer">
                    <p>Opening orders start at 50 units. We’ll confirm how quantities are counted across products when we speak.</p>
                </div>
            </div>

            <!-- FAQ 3 -->
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false">
                    <span>What margins do partners earn?</span>
                    <span class="faq-toggle">+</span>
                </button>
                <div class="faq-answer">
                    <p>Tulia offers trade margins of 35% to 50%, confirmed by your order size. We’ll share your exact trade pricing when we speak.</p>
                </div>
            </div>

            <!-- FAQ 4 -->
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false">
                    <span>Can I order more than 100 units or reorder regularly?</span>
                    <span class="faq-toggle">+</span>
                </button>
                <div class="faq-answer">
                    <p>Yes. Larger, repeat and multi-location orders are welcome — share your expected volume on the form and we’ll discuss terms one-to-one.</p>
                </div>
            </div>

            <!-- FAQ 5 -->
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false">
                    <span>How long does delivery take?</span>
                    <span class="faq-toggle">+</span>
                </button>
                <div class="faq-answer">
                    <p>Delivery depends on your location and order size. Your Tulia contact will confirm dates when you place your order.</p>
                </div>
            </div>

            <!-- FAQ 6 -->
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false">
                    <span>How do I pay?</span>
                    <span class="faq-toggle">+</span>
                </button>
                <div class="faq-answer">
                    <p>We’ll confirm payment terms for your order when we speak.</p>
                </div>
            </div>

            <!-- FAQ 7 -->
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false">
                    <span>Are the products suitable for sensitive skin?</span>
                    <span class="faq-toggle">+</span>
                </button>
                <div class="faq-answer">
                    <p>Tulia formulas are patch-tested, pH-balanced and free from parabens, sulfates and mineral oil. As with any product, we recommend clients patch-test first and follow label directions.</p>
                </div>
            </div>
        </div>
    </section>

