                            <li><a href="/pages/bulk-buy#signature">Shampoo & Conditioner</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h3 class="footer-heading">TRADE ENQUIRIES</h3>
                        <ul class="footer-links">
                            <li><a href="/pages/bulk-buy#trade-enquiry">Get Trade Pricing</a></li>
                            <li><a href="/pages/bulk-buy#about">Co-Founder&rsquo;s Note</a></li>
                            <li><a href="https://wa.me/918148148487" target="_blank" rel="noopener noreferrer">WhatsApp: +91 81481 48487</a></li>
                            <li><a href="https://tuliacosmetics.com/" target="_blank" rel="noopener noreferrer">Shop Tulia</a></li>
                            <li><a href="https://tuliacosmetics.com/policies/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
                        </ul>
                    </div>
                </div>

                <div class="footer-social-section" style="padding-right: 2rem;">
                    <div class="social-icons">
                        <a href="https://www.instagram.com/tuliacosmetics" target="_blank" rel="noopener noreferrer"
                            aria-label="Instagram">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="footer-right-col">
                <div class="footer-image-banner">
                    <img src="{{ 'tulia-branding.png' | asset_url }}" alt="Tulia Branding" width="260" height="80">
                </div>

                <div class="newsletter-wrapper">
                    <h3 class="newsletter-title mb-small"
                        style="font-family: var(--font-serif); font-size: 2.5rem; font-weight: 400; line-height: 1.1; white-space: normal;">
                        Outgrow the standards</h3>
                    <p class="newsletter-desc mb-medium text-white">Intentionally formulated for preserving skin longevity</p>
                    <div style="margin-top: 0.5rem;">
                        <a href="/pages/bulk-buy#trade-enquiry" class="btn btn-primary-light">REQUEST TRADE PRICING</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom-bar">
            <div class="container footer-bottom-content"
                style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <div class="copyright-text" style="font-size: 0.75rem; color: rgba(255,255,255,0.7); font-weight: 400;">
                    Copyright &copy; 2026 Tulia Cosmetics. All rights reserved.
                </div>
                <div class="developed-by-text"
