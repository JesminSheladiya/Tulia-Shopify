{% layout none %}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thank You | Tulia Cosmetics</title>
    <meta name="description"
        content="Thank you for your trade enquiry. Our team will be in touch with your trade pricing soon.">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Kanit:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" href="{{ 'fav-icon.png' | asset_url }}">

    {{ content_for_header }}

    <!-- Custom font (defined here as fallback in case .css.liquid Liquid processing varies) -->
    <style>
        @font-face {
            font-family: 'Mattone';
            src: url('{{ 'Mattone-Regular.otf' | asset_url }}') format('opentype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
            unicode-range: U+0000-0025, U+0027-FFFF;
        }
    </style>

    <!-- Stylesheet -->
    <link rel="stylesheet" href="{{ 'wholesale-page.css' | asset_url }}">
</head>

<body>

    <!-- ===== HEADER (Same as Bulk-Buy Page) ===== -->
    <header class="site-header">
        <div class="container header-container">
            <div class="mobile-menu-wrapper">
                <button class="icon-btn mobile-menu" id="mobile-menu-btn" aria-label="Toggle navigation"
                    aria-expanded="false">
                    <span class="material-symbols-outlined">menu</span>
                </button>
            </div>

            <div class="header-center-nav">
                <nav class="main-nav left-nav">
                    <a href="/" class="nav-link">Home</a>
                    <a href="/pages/bulk-buy" class="nav-link">Wholesale Programme</a>
                </nav>
                <a href="/" class="logo-link">
                    <img src="{{ 'logo-color.png' | asset_url }}" alt="Tulia Logo" class="header-logo" width="240"
                        height="72">
                </a>
                <nav class="main-nav right-nav">
                    <a href="/collections/all" class="nav-link">Shop</a>
                </nav>
            </div>

            <div class="header-icons">
                <a href="https://wa.me/918148148487" target="_blank" rel="noopener noreferrer"
                    class="btn btn-primary btn-sm header-cta-btn">Chat on WhatsApp</a>
            </div>
        </div>

        <!-- Mobile & Tablet Navigation Drawer -->
        <nav class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Mobile Navigation">
            <a href="/" class="mobile-nav-link">Home</a>
            <a href="/pages/bulk-buy" class="mobile-nav-link">Wholesale Programme</a>
            <a href="/collections/all" class="mobile-nav-link">Shop</a>
            <a href="https://wa.me/918148148487" target="_blank" rel="noopener noreferrer"
                class="btn btn-primary w-full mobile-nav-cta">Chat on WhatsApp</a>
        </nav>
    </header>

    <!-- ===== THANK YOU SECTION ===== -->
    <section class="section thank-you-section">
        <div class="container">
            <div class="thank-you-content reveal">
                <!-- Success Icon -->
                <div class="thank-you-icon" aria-hidden="true">
                    <span class="material-symbols-outlined" style="font-size:70px">check_circle</span>
                </div>

                <!-- Thank You Message -->
                <h2 class="section-title">Thank You!</h2>
                <div class="divider mx-auto"></div>

                <p class="thank-you-message">
                    We&rsquo;ve received your trade enquiry. Someone from Tulia will be in touch with your trade pricing via WhatsApp within 24 hours.
                </p>

                <!-- What to Expect -->
                <div class="thank-you-expect">
                    <div class="expect-item">
                        <span class="material-symbols-outlined">schedule</span>
                        <span>Response within 24 hrs</span>
                    </div>
                    <div class="expect-item">
                        <span class="material-symbols-outlined">chat</span>
                        <span>Via WhatsApp</span>
                    </div>
                    <div class="expect-item">
                        <span class="material-symbols-outlined">verified</span>
                        <span>Custom trade pricing</span>
                    </div>
                </div>

                <!-- CTA Actions -->
                <div class="thank-you-actions">
                    <a href="/collections/all" class="btn btn-primary-light">Continue Shopping</a>
                    <a href="https://wa.me/918148148487" target="_blank" rel="noopener noreferrer"
                        class="btn btn-primary whatsapp-btn">
                        <svg width="20" height="20" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"
                            class="whatsapp-icon">
                            <path
                                d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                        </svg>
                        Chat on WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FOOTER (Same as Bulk-Buy Page) ===== -->
